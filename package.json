{
	"name": "codex",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:backend": "bun run --cwd apps/backend dev",
		"dev:frontend": "bun run --cwd apps/frontend dev",
		"infra:up": "docker compose up -d",
		"infra:down": "docker compose down",
		"infra:logs": "docker compose logs -f",
		"verify:embeddings": "bun run packages/shared/src/verifyEmbeddings.ts"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"prettier": "^3.8.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
