{
	"name": "codex",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:backend": "bun run --cwd apps/backend dev",
		"dev:frontend": "bun run --cwd apps/frontend dev",
		"infra:up": "docker compose up -d",
		"infra:down": "docker compose down",
		"infra:logs": "docker compose logs -f",
		"verify:embeddings": "bun run packages/shared/src/verifyEmbeddings.ts",
		"lint": "bun run eslint .",
		"lint:fix": "bun run eslint . --fix"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "latest",
		"eslint": "^10.0.3",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"typescript-eslint": "^8.57.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
