{
	"name": "codex",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:backend": "bun run --watch apps/backend/src/index.ts",
		"dev:frontend": "bun run --watch apps/frontend/src/main.tsx",
		"infra:up": "docker-compose up -d",
		"infra:down": "docker-compose down",
		"infra:logs": "docker-compose logs -f",
		"verify:embeddings": "bun run packages/shared/src/verifyEmbeddings.ts",
		"lint": "bun run eslint .",
		"lint:fix": "bun run eslint . --fix",
		"cli": "bun run --watch apps/cli/src/index.ts",
		"build:cli": "bun build apps/cli/src/index.ts --compile --outfile codex",
		"benchmark": "bun run packages/rag/src/benchmark/runBenchmark.ts",
		"rag:validate": "bun run packages/rag/src/benchmark/validate.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "latest",
		"eslint": "^10.0.3",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"typescript-eslint": "^8.57.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"jiti": "^2.6.1"
	}
}
